POSTGRES_HOST=localhost
POSTGRES_USER=wealthogic
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
POSTGRES_DB=wealthogic

CORS_ORIGIN=http://localhost:5173

GIN_MODE=debug

PORT=8080

# Market data provider (Financial Modeling Prep), for a holding's sector and
# industry. Optional: without it holdings are created without that detail and
# nothing else changes.
FMP_API_KEY=

# Quote provider for refreshing holding prices, independent of the profile
# provider above. "marketdata.app" or "fmp"; left empty it uses whichever has a
# key, preferring marketdata.app - FMP's free tier answers 402 Payment Required
# for symbols off the major exchanges.
QUOTE_PROVIDER=marketdata.app

# API key for marketdata.app (https://www.marketdata.app). Optional: without it
# price refreshes fall back to FMP, or are switched off if that has no key.
MARKETDATA_API_KEY=
